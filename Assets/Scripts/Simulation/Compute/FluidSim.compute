float PressureFromDensity(float density)
{
    return (density - targetDensity) * pressureMultiplier;
}

float NearPressureFromDensity(float nearDensity)
{
    return nearDensity * nearPressureMultiplier;
}


float Remap01(float val, float minVal, float maxVal)
{
    return saturate((val - minVal) / (maxVal - minVal));
}

// Match FluidSim.MaxIceBodies and the host uniform arrays.
#define MAX_BOX_BOUNDARIES 12
int iceCount;
bool BoxWallPressure;
float4 iceHalfExtents[MAX_BOX_BOUNDARIES];
float4x4 iceWorldToLocal[MAX_BOX_BOUNDARIES], iceLocalToWorld[MAX_BOX_BOUNDARIES];
float4 iceVelocity[MAX_BOX_BOUNDARIES], iceAngularVelocity[MAX_BOX_BOUNDARIES], iceMassCentre[MAX_BOX_BOUNDARIES];

void ResolveIceBody(int index, float3 previous, inout float3 position, inout float3 velocity)
{
    float3 iceHalfExtent = iceHalfExtents[index].xyz;
    const float separation = .00005;
    float3 start = mul(iceWorldToLocal[index], float4(previous, 1)).xyz;
    float3 end = mul(iceWorldToLocal[index], float4(position, 1)).xyz;
    float3 inside = iceHalfExtent - abs(end);
    float3 axis;
    float signNormal;

    if (all(abs(start) < iceHalfExtent))
    {
        // A moving solid can engulf a particle between updates.
        if (any(inside <= 0)) return;
        axis = inside.x <= min(inside.y, inside.z) ? float3(1,0,0)
            : inside.y <= inside.z ? float3(0,1,0) : float3(0,0,1);
        signNormal = dot(axis, end) < 0 ? -1 : 1;
        end += axis * signNormal * (dot(inside, axis) + separation);
    }
    else
    {
        // Find the first crossed face, including a segment that exits the far side.
        float3 motion = end - start;
        float3 direction = step(0, motion) * 2 - 1;
        if (any((abs(motion) < 1e-8) & (abs(start) >= iceHalfExtent))) return;
        float3 reciprocal = direction / max(abs(motion), 1e-8);
        float3 first = (-iceHalfExtent - start) * reciprocal;
        float3 second = (iceHalfExtent - start) * reciprocal;
        float3 nearFace = min(first, second);
        float3 farFace = max(first, second);
        float entry = max(nearFace.x, max(nearFace.y, nearFace.z));
        float exitTime = min(farFace.x, min(farFace.y, farFace.z));
        if (entry < 0 || entry > 1 || exitTime < entry) return;
        axis = nearFace.x >= max(nearFace.y, nearFace.z) ? float3(1,0,0)
            : nearFace.y >= nearFace.z ? float3(0,1,0) : float3(0,0,1);
        signNormal = -dot(axis, direction);
        end = lerp(start, end, entry) + axis * signNormal * separation;
    }

    position = mul(iceLocalToWorld[index], float4(end, 1)).xyz;
    float3 normal = mul((float3x3)iceLocalToWorld[index], axis * signNormal);
    float3 surfaceVelocity = iceVelocity[index].xyz + cross(iceAngularVelocity[index].xyz, position - iceMassCentre[index].xyz);
    velocity -= normal * min(0, dot(velocity - surfaceVelocity, normal));
}

void ResolveIce(float3 previous, inout float3 position, inout float3 velocity)
{
    for (int index = 0; index < iceCount; index++)
        ResolveIceBody(index, previous, position, velocity);
}

void ResolveCollisions(inout float3 pos, inout float3 vel, float collisionDamping)
{
    // Transform position/velocity to the local space of the bounding box
    float3 posLocal = mul(worldToLocal, float4(pos, 1)).xyz;
    float3 velocityLocal = mul(worldToLocal, float4(vel, 0)).xyz;

    // Calculate distance from box on each axis (negative values are outside box)
    const float3 halfSize = 0.5;
    const float3 edgeDst = halfSize - abs(posLocal);

    // Resolve collisions
    if (edgeDst.x <= 0)
    {
        posLocal.x = halfSize.x * sign(posLocal.x);
        velocityLocal.x *= -1 * collisionDamping;
    }
    if (edgeDst.y <= 0)
    {
        posLocal.y = halfSize.y * sign(posLocal.y);
        velocityLocal.y *= -1 * collisionDamping;
    }
    if (edgeDst.z <= 0)
    {
        posLocal.z = halfSize.z * sign(posLocal.z);
        velocityLocal.z *= -1 * collisionDamping;
    }

    // Transform resolved position/velocity back to world space
    pos = mul(localToWorld, float4(posLocal, 1)).xyz;
    vel = mul(localToWorld, float4(velocityLocal, 0)).xyz;
}

void ResolveBeaker(float3 previous, inout float3 position, inout float3 velocity)
{
    float radius = beakerCollision.z;
    if (radius <= 0) return;
    float2 centre = beakerCollision.xy;
    float floorY = beakerCollision.w;
    float2 radial = position.xz - centre;
    float distance = length(radial);
    float2 previousRadial = previous.xz - centre;
    bool wasInside = previous.y >= beakerGlassFloorY - 1e-5 && previous.y < beakerRimY &&
        dot(previousRadial, previousRadial) <= radius * radius * 1.00001;
    bool enteredOpening = previous.y >= beakerRimY && distance <= radius;
    if (position.y >= beakerRimY || (!wasInside && !enteredOpening)) return;

    if (position.y < floorY)
    {
        position.y = floorY;
        if (velocity.y < 0) velocity.y *= -collisionDamping;
    }
    if (distance > radius)
    {
        float2 normal = radial / distance;
        position.xz = centre + normal * radius;
        float outward = dot(velocity.xz, normal);
        if (outward > 0) velocity.xz -= (1 + collisionDamping) * outward * normal;
    }
}

void ApplyExternalForces(uint3 id)
{
    if (id.x >= numParticles)
        return;

    float acceleration = gravity;
#ifdef THERMAL_PARTICLES
    float3 p = Positions[id.x];
    float2 radial = p.xz - beakerCollision.xy;
    if (ThermalBuoyancy > .5 && p.y >= beakerCollision.w - 1e-5 && p.y < beakerRimY &&
        dot(radial, radial) <= beakerCollision.z * beakerCollision.z + 1e-8)
    {
        // The pressure solver uses the reference liquid density. Only the
        // departure from it contributes an additional buoyancy acceleration.
        float row = clamp(TemperatureRise[id.x], 0, (float)(BuoyancyDensityCount - 1));
        int low = min((int)row, BuoyancyDensityCount - 2);
        float density = lerp(BuoyancyDensity[low], BuoyancyDensity[low + 1], row - low);
        float referenceDensity = BuoyancyDensity[0];
        acceleration += abs(gravity) * (referenceDensity - density) / referenceDensity;
    }
#endif
    Velocities[id.x] += float3(0, acceleration, 0) * deltaTime;

    // Predict
    float3 previous = Positions[id.x];
    float3 predictedVelocity = Velocities[id.x];
    float3 predicted = previous + predictedVelocity * predictionTime;
    ResolveIce(previous, predicted, predictedVelocity);
    PredictedPositions[id.x] = predicted;
}

[numthreads(ThreadGroupSize, 1, 1)]
void ExternalForces(uint3 id : SV_DispatchThreadID) { ApplyExternalForces(id); }
[numthreads(ThreadGroupSize, 1, 1)]
void ExternalForcesWithHeat(uint3 id : SV_DispatchThreadID) { ApplyExternalForces(id); }

RWStructuredBuffer<float> LiquidFraction;

uint MixedLevel(uint index)
{
    return LiquidFraction[index] > 2 ? 1 : 0;
}

uint MixedCellKey(int3 cell, uint level)
{
    return KeyFromHash(2 * HashCell3D(cell) + level, numParticles);
}

[numthreads(ThreadGroupSize, 1, 1)]
#ifdef MIXED_RESOLUTION
void UpdateMixedSpatialHash(uint3 id : SV_DispatchThreadID)
#else
void UpdateSpatialHash(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= numParticles)
        return;

    uint index = id.x;
#ifdef MIXED_RESOLUTION
    uint level = MixedLevel(index);
    int3 cell = GetCell3D(PredictedPositions[index], smoothingRadius * (level + 1));
    SpatialKeys[index] = MixedCellKey(cell, level);
#else
    int3 cell = GetCell3D(PredictedPositions[index], smoothingRadius);
    SpatialKeys[index] = KeyFromHash(HashCell3D(cell), numParticles);
#endif
}


RWStructuredBuffer<float3> SortTarget_Positions;
RWStructuredBuffer<float3> SortTarget_PredictedPositions;
RWStructuredBuffer<float3> SortTarget_Velocities;
RWStructuredBuffer<float> SortedTemperatureRise;
RWStructuredBuffer<float> SortedLiquidFraction;
int TrackLiquidMass;

float LiquidWeight(uint index)
{
    return TrackLiquidMass != 0 ? LiquidFraction[index] : 1;
}

[numthreads(ThreadGroupSize, 1, 1)]
void SortLiquidMass(uint3 id : SV_DispatchThreadID)
{
    if (id.x < numParticles) SortedLiquidFraction[id.x] = LiquidFraction[SortedIndices[id.x]];
}

[numthreads(ThreadGroupSize, 1, 1)]
void CopyLiquidMass(uint3 id : SV_DispatchThreadID)
{
    if (id.x < numParticles) LiquidFraction[id.x] = SortedLiquidFraction[id.x];
}

void ReorderData(uint3 id)
{
    if (id.x >= numParticles)
        return;
    uint sortedIndex = SortedIndices[id.x];
    SortTarget_Positions[id.x] = Positions[sortedIndex];
    SortTarget_PredictedPositions[id.x] = PredictedPositions[sortedIndex];
    SortTarget_Velocities[id.x] = Velocities[sortedIndex];
#ifdef THERMAL_PARTICLES
    SortedTemperatureRise[id.x] = TemperatureRise[sortedIndex];

#endif
}

void CopyReorderedData(uint3 id)
{
    if (id.x >= numParticles)
        return;

    Positions[id.x] = SortTarget_Positions[id.x];
    PredictedPositions[id.x] = SortTarget_PredictedPositions[id.x];
    Velocities[id.x] = SortTarget_Velocities[id.x];
#ifdef THERMAL_PARTICLES
    TemperatureRise[id.x] = SortedTemperatureRise[id.x];

#endif
}

[numthreads(ThreadGroupSize, 1, 1)]
void Reorder(uint3 id : SV_DispatchThreadID) { ReorderData(id); }
[numthreads(ThreadGroupSize, 1, 1)]
void ReorderCopyBack(uint3 id : SV_DispatchThreadID) { CopyReorderedData(id); }
[numthreads(ThreadGroupSize, 1, 1)]
void ReorderWithHeat(uint3 id : SV_DispatchThreadID) { ReorderData(id); }
[numthreads(ThreadGroupSize, 1, 1)]
void ReorderCopyBackWithHeat(uint3 id : SV_DispatchThreadID) { CopyReorderedData(id); }

RWStructuredBuffer<float> ThermalNeighbourWeight;
float LiquidThermalDiffusivity;

float ThermalExchange(uint index, bool diffuse)
{
    float3 position = PredictedPositions[index];
    int3 origin = GetCell3D(position, smoothingRadius);
    float total = 0;
    float rate = min(0.5, 6 * LiquidThermalDiffusivity * deltaTime / (smoothingRadius * smoothingRadius));
    for (int offset = 0; offset < 27; offset++)
    {
        int3 cell = origin + offsets3D[offset];
        uint key = KeyFromHash(HashCell3D(cell), numParticles);
        for (uint neighbour = SpatialOffsets[key]; neighbour < numParticles && SpatialKeys[neighbour] == key; neighbour++)
        {
            if (neighbour == index) continue;
            float3 other = PredictedPositions[neighbour];
            // Reject hash collisions so a pair is counted once in each direction.
            if (any(GetCell3D(other, smoothingRadius) != cell)) continue;
            float weight = LiquidWeight(neighbour) * max(0, 1 - distance(position, other) / smoothingRadius);
            if (diffuse)
            {
                // Symmetric denominator and mass-weighted flux give equal and
                // opposite energy updates while bounding each temperature step.
                float normalizer = max(1, max(ThermalNeighbourWeight[index], ThermalNeighbourWeight[neighbour]));
                total += weight * (TemperatureRise[neighbour] - TemperatureRise[index]) / normalizer;
            }
            else total += weight;
        }
    }
    return diffuse ? rate * total : total;
}

[numthreads(ThreadGroupSize, 1, 1)]
void SumThermalNeighbours(uint3 id : SV_DispatchThreadID)
{
    if (id.x < numParticles)
        ThermalNeighbourWeight[id.x] = LiquidWeight(id.x) > 0 ? ThermalExchange(id.x, false) : 0;
}

[numthreads(ThreadGroupSize, 1, 1)]
void DiffuseLiquidHeat(uint3 id : SV_DispatchThreadID)
{
    if (id.x < numParticles)
        SortedTemperatureRise[id.x] = TemperatureRise[id.x] +
            (LiquidWeight(id.x) > 0 ? ThermalExchange(id.x, true) : 0);
}

[numthreads(ThreadGroupSize, 1, 1)]
void CommitLiquidHeat(uint3 id : SV_DispatchThreadID)
{
    if (id.x < numParticles) TemperatureRise[id.x] = SortedTemperatureRise[id.x];
}

bool SupportsFloorMirror(float3 p)
{
    float2 radial = p.xz - beakerCollision.xy;
    return p.y >= beakerGlassFloorY && p.y < beakerRimY &&
        dot(radial, radial) <= beakerCollision.z * beakerCollision.z + 1e-8;
}

float3 FloorMirror(float3 p)
{
    p.y = 2 * beakerGlassFloorY - p.y;
    return p;
}

// Mirror fluid neighbours across the nearest planar face of a solid box.
float4 FindBoxPressurePlane(float3 pos)
{
    float4 plane = 0;
    float closest = smoothingRadius;
    if (!BoxWallPressure) return plane;

    for (int index = 0; index < iceCount; index++)
    {
        float3 local = mul(iceWorldToLocal[index], float4(pos, 1)).xyz;
        float3 halfSize = iceHalfExtents[index].xyz;
        float3 outside = abs(local) - halfSize;
        float3 axis = step(0, outside);
        if (dot(axis, float3(1, 1, 1)) != 1) continue;
        float gap = dot(axis, outside);
        if (gap >= closest) continue;

        float3 localNormal = axis * sign(local);
        float3 normal = mul((float3x3)iceLocalToWorld[index], localNormal);
        plane = float4(normal, dot(normal, pos) - gap);
        closest = gap;
    }
    return plane;
}

float BoxPlaneDistance(float4 plane, float3 position)
{
    return dot(plane.xyz, position) - plane.w;
}

// Reject cells whose closest point lies outside the particle's support sphere.
bool IntersectsSupportCell(float3 gridPosition, int3 cell, float3 padding)
{
    float3 minimum = (float3)cell;
    float3 gap = max(minimum - gridPosition, gridPosition - (minimum + 1));
    gap = max(0, gap - padding);
    return dot(gap, gap) <= 1;
}

float2 CalculateDensitiesAtPoint(float3 pos, bool includeBoxPressure)
{
    float3 gridPosition = pos / smoothingRadius;
    int3 originCell = (int3)floor(gridPosition);
    // Keep borderline cells despite floating-point rounding near grid boundaries.
    float3 cellPadding = 1e-6 * max(abs(gridPosition), 1);
    float sqrRadius = smoothingRadius * smoothingRadius;
    float density = 0;
    float nearDensity = 0;
    bool floorSupport = BeakerFloorPressure > .5 && SupportsFloorMirror(pos) && pos.y - beakerGlassFloorY < smoothingRadius;
    float4 wallPlane = includeBoxPressure ? FindBoxPressurePlane(pos) : 0;
    bool boxSupport = any(wallPlane.xyz != 0);

    // Neighbour search
    for (int i = 0; i < 27; i++)
    {
        int3 cell = originCell + offsets3D[i];
        if (!IntersectsSupportCell(gridPosition, cell, cellPadding)) continue;
        uint hash = HashCell3D(cell);
        uint key = KeyFromHash(hash, numParticles);
        uint currIndex = SpatialOffsets[key];

        while (currIndex < numParticles)
        {
            uint neighbourIndex = currIndex;
            currIndex++;

            uint neighbourKey = SpatialKeys[neighbourIndex];
            // Exit if no longer looking at correct bin
            if (neighbourKey != key)
                break;

            float3 neighbourPos = PredictedPositions[neighbourIndex];
            float3 offsetToNeighbour = neighbourPos - pos;
            float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

            // Skip if not within radius
            if (sqrDstToNeighbour > sqrRadius)
                continue;
            // A hash bucket can contain particles from multiple cells.
            if (any(GetCell3D(neighbourPos, smoothingRadius) != cell)) continue;

            // Calculate density and near density
            float dst = sqrt(sqrDstToNeighbour);
            float weight = LiquidWeight(neighbourIndex);
            density += weight * DensityKernel(dst, smoothingRadius);
            nearDensity += weight * NearDensityKernel(dst, smoothingRadius);
            if (boxSupport)
            {
                float gap = BoxPlaneDistance(wallPlane, neighbourPos);
                if (gap >= 0)
                {
                    float reflectedDistance = distance(neighbourPos - 2 * gap * wallPlane.xyz, pos);
                    density += weight * DensityKernel(reflectedDistance, smoothingRadius);
                    nearDensity += weight * NearDensityKernel(reflectedDistance, smoothingRadius);
                }
            }
            if (floorSupport && SupportsFloorMirror(neighbourPos))
            {
                float reflectedDistance = distance(FloorMirror(neighbourPos), pos);
                density += weight * DensityKernel(reflectedDistance, smoothingRadius);
                nearDensity += weight * NearDensityKernel(reflectedDistance, smoothingRadius);
            }
        }
    }

    return float2(density, nearDensity);
}

// A coarse cell spans two fine cells per axis, with two fine cells of support on each side.
static const uint FineMaskWords = 7;
static const uint FineCellsPerAxis = 6;
int3 MixedCacheOrigin;
int3 MixedCacheSize;
uint MixedCacheGeneration;
RWStructuredBuffer<uint> MixedCacheClaims;
RWStructuredBuffer<uint> MixedFineMaskOutput;
StructuredBuffer<uint> MixedFineMasks;

bool TryMixedCacheIndex(int3 coarseCell, out uint index)
{
    int3 cell = coarseCell - MixedCacheOrigin;
    index = 0;
    if (any(cell < 0) || any(cell >= MixedCacheSize)) return false;
    index = cell.x + MixedCacheSize.x * (cell.y + MixedCacheSize.y * cell.z);
    return true;
}

int3 FineMaskOffset(uint bit)
{
    return int3(bit % FineCellsPerAxis, (bit / FineCellsPerAxis) % FineCellsPerAxis,
        bit / (FineCellsPerAxis * FineCellsPerAxis));
}

[numthreads(ThreadGroupSize, 1, 1)]
void BuildMixedFineCellMasks(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles || MixedLevel(id.x) != 1) return;

    int3 coarseCell = GetCell3D(PredictedPositions[id.x], 2 * smoothingRadius);
    uint index;
    if (!TryMixedCacheIndex(coarseCell, index)) return;
    uint previous;
    InterlockedExchange(MixedCacheClaims[index], MixedCacheGeneration, previous);
    if (previous == MixedCacheGeneration) return;

    int3 firstFineCell = 2 * coarseCell - 2;
    uint mask = 0;
    for (uint bit = 0; bit < 216; bit++)
    {
        uint key = MixedCellKey(firstFineCell + FineMaskOffset(bit), 0);
        // Hash aliases can set extra bits. Query-time cell and level checks reject them.
        if (SpatialOffsets[key] < numParticles) mask |= 1u << (bit % 32);
        if (bit % 32 == 31 || bit == 215)
        {
            MixedFineMaskOutput[index * FineMaskWords + bit / 32] = mask;
            mask = 0;
        }
    }
}

// The two levels share a sparse hash table. Their cell widths are h and 2h.
struct MixedNeighbourQuery
{
    float3 position;
    uint selfLevel;
    uint level;
    float cellWidth;
    float reachSquared;
    int3 firstCell;
    int3 lastCell;
    int3 cell;
    uint key;
    uint cursor;
    bool useFineMask;
    int3 firstFineCell;
    uint fineMaskIndex;
    uint fineMaskWord;
    uint fineMaskBits;
};

void SetMixedQueryLevel(inout MixedNeighbourQuery query, uint level)
{
    query.level = level;
    query.cellWidth = smoothingRadius * (level + 1);
    float support = smoothingRadius * (max(query.selfLevel, level) + 1);
    query.reachSquared = support * support;
    query.firstCell = GetCell3D(query.position - support, query.cellWidth);
    query.lastCell = GetCell3D(query.position + support, query.cellWidth);
    query.cell = query.firstCell;
    query.cell.x--;
    query.key = 0;
    query.cursor = numParticles;
    query.useFineMask = false;
    query.firstFineCell = 0;
    query.fineMaskIndex = 0;
    query.fineMaskWord = 0;
    query.fineMaskBits = 0;
    if (query.selfLevel == 1 && level == 0)
    {
        int3 coarseCell = GetCell3D(query.position, 2 * smoothingRadius);
        query.firstFineCell = 2 * coarseCell - 2;
        if (all(query.firstCell >= query.firstFineCell) && all(query.lastCell <= query.firstFineCell + 5) &&
            TryMixedCacheIndex(coarseCell, query.fineMaskIndex))
        {
            query.useFineMask = true;
            query.fineMaskBits = MixedFineMasks[query.fineMaskIndex * FineMaskWords];
        }
    }
}

MixedNeighbourQuery MakeMixedQuery(float3 position, uint selfLevel)
{
    MixedNeighbourQuery query;
    query.position = position;
    query.selfLevel = selfLevel;
    SetMixedQueryLevel(query, 0);
    return query;
}

bool NextMixedNeighbour(inout MixedNeighbourQuery query, out uint index, out float3 offset, out float distanceSquared)
{
    index = 0;
    offset = 0;
    distanceSquared = 0;
    while (true)
    {
        if (query.cursor < numParticles && SpatialKeys[query.cursor] == query.key)
        {
            uint candidate = query.cursor++;
            float3 position = PredictedPositions[candidate];
            float3 delta = position - query.position;
            float squaredDistance = dot(delta, delta);
            if (squaredDistance > query.reachSquared || MixedLevel(candidate) != query.level ||
                any(GetCell3D(position, query.cellWidth) != query.cell)) continue;
            index = candidate;
            offset = delta;
            distanceSquared = squaredDistance;
            return true;
        }

        if (query.useFineMask)
        {
            while (query.fineMaskBits == 0 && query.fineMaskWord + 1 < FineMaskWords)
            {
                query.fineMaskWord++;
                query.fineMaskBits = MixedFineMasks[query.fineMaskIndex * FineMaskWords + query.fineMaskWord];
            }
            if (query.fineMaskBits == 0)
            {
                SetMixedQueryLevel(query, 1);
                continue;
            }
            uint bit = firstbitlow(query.fineMaskBits);
            query.fineMaskBits &= query.fineMaskBits - 1;
            query.cell = query.firstFineCell + FineMaskOffset(32 * query.fineMaskWord + bit);
            if (any(query.cell < query.firstCell) || any(query.cell > query.lastCell)) continue;
            query.key = MixedCellKey(query.cell, 0);
            query.cursor = SpatialOffsets[query.key];
            continue;
        }

        query.cell.x++;
        if (query.cell.x > query.lastCell.x)
        {
            query.cell.x = query.firstCell.x;
            query.cell.y++;
            if (query.cell.y > query.lastCell.y)
            {
                query.cell.y = query.firstCell.y;
                query.cell.z++;
                if (query.cell.z > query.lastCell.z)
                {
                    if (query.level == 1) return false;
                    SetMixedQueryLevel(query, 1);
                    continue;
                }
            }
        }
        query.key = MixedCellKey(query.cell, query.level);
        query.cursor = SpatialOffsets[query.key];
    }
    return false;
}

float2 MixedDensityKernel(float d, uint level)
{
    float width = smoothingRadius * (level + 1);
    // Evaluate with the fine-level normalization, then scale by h^-3.
    float scale = level == 0 ? 1 : .125;
    float fineDistance = d * smoothingRadius / width;
    return scale * float2(DensityKernel(fineDistance, smoothingRadius), NearDensityKernel(fineDistance, smoothingRadius));
}

float2 MixedGradient(float d, uint level)
{
    float scale = level == 0 ? 1 : .0625;
    float fineDistance = d / (level + 1);
    return scale * float2(DensityDerivative(fineDistance, smoothingRadius), NearDensityDerivative(fineDistance, smoothingRadius));
}

float2 MixedDensityAt(float3 position, uint level, bool sampleSurface)
{
    MixedNeighbourQuery query = MakeMixedQuery(position, level);
    uint j;
    float3 offset;
    float distanceSquared;
    float2 density = 0;
    while (NextMixedNeighbour(query, j, offset, distanceSquared))
    {
        float d = sqrt(distanceSquared);
        float2 weight = MixedDensityKernel(d, query.level);
        if (!sampleSurface && query.level != level)
            weight = .5 * (weight + MixedDensityKernel(d, level));
        density += LiquidFraction[j] * weight;
    }
    return density;
}

void ApplyMixedPressure(uint index)
{
    uint level = MixedLevel(index);
    float2 density = max(Densities[index], 1e-6);
    float pressure = PressureFromDensity(density.x);
    float nearPressure = NearPressureFromDensity(density.y);
    MixedNeighbourQuery query = MakeMixedQuery(PredictedPositions[index], level);
    uint j;
    float3 offset;
    float distanceSquared;
    float3 acceleration = 0;
    while (NextMixedNeighbour(query, j, offset, distanceSquared))
    {
        if (j == index || distanceSquared == 0) continue;
        float d = sqrt(distanceSquared);
        float2 neighbourDensity = max(Densities[j], 1e-6);
        float2 gradient = MixedGradient(d, query.level);
        if (query.level != level)
            gradient = .5 * (gradient + MixedGradient(d, level));
        float pressureFactor = .5 * (pressure + PressureFromDensity(neighbourDensity.x)) /
            (density.x * neighbourDensity.x);
        float nearFactor = .25 * (nearPressure + NearPressureFromDensity(neighbourDensity.y)) *
            (1 / (density.x * neighbourDensity.y) + 1 / (neighbourDensity.x * density.y));
        acceleration += LiquidFraction[j] * (offset / d) * dot(gradient, float2(pressureFactor, nearFactor));
    }
    Velocities[index] += acceleration * deltaTime;
}

void ApplyMixedViscosity(uint index)
{
    uint level = MixedLevel(index);
    float3 velocity = Velocities[index];
    MixedNeighbourQuery query = MakeMixedQuery(PredictedPositions[index], level);
    uint j;
    float3 offset;
    float distanceSquared;
    float3 acceleration = 0;
    while (NextMixedNeighbour(query, j, offset, distanceSquared))
    {
        if (j == index) continue;
        float d = sqrt(distanceSquared);
        float weight = SmoothingKernelPoly6(d / (query.level + 1), smoothingRadius) *
            (query.level == 0 ? 1 : .125);
        if (query.level != level)
            weight = .5 * (weight + SmoothingKernelPoly6(d / (level + 1), smoothingRadius) *
                (level == 0 ? 1 : .125));
        acceleration += LiquidFraction[j] * weight * (Velocities[j] - velocity);
    }
    SortTarget_Velocities[index] = velocity + acceleration * viscosityStrength * deltaTime;
}

[numthreads(ThreadGroupSize, 1, 1)]
#ifdef MIXED_RESOLUTION
void CalculateMixedDensities(uint3 id : SV_DispatchThreadID)
#else
void CalculateDensities(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= numParticles)
        return;

    float3 pos = PredictedPositions[id.x];
#ifdef MIXED_RESOLUTION
    float2 densities = MixedDensityAt(pos, MixedLevel(id.x), false);
#else
    float2 densities = CalculateDensitiesAtPoint(pos, true);
#endif

    Densities[id.x] = densities;
}

// PCG (permuted congruential generator). Thanks to:
// www.pcg-random.org and www.shadertoy.com/view/XlGcRh
uint NextRandom(inout uint state)
{
    state = state * 747796405 + 2891336453;
    uint result = ((state >> ((state >> 28) + 4)) ^ state) * 277803737;
    result = (result >> 22) ^ result;
    return result;
}

float RandomValue(inout uint state)
{
    return NextRandom(state) / 4294967295.0; // 2^32 - 1
}

// Thanks to https://math.stackexchange.com/a/4112622
// Calculates arbitrary normalized vector that is perpendicular to the given direction
float3 CalculateOrthonormal(float3 dir)
{
    float a = sign((sign(dir.x) + 0.5) * (sign(dir.z) + 0.5));
    float b = sign((sign(dir.y) + 0.5) * (sign(dir.z) + 0.5));
    float3 orthoVec = float3(a * dir.z, b * dir.z, -a * dir.x - b * dir.y);
    return normalize(orthoVec);
}


float3 FloorPressureForce(float3 pos, float3 neighbour, float2 neighbourDensity, float pressure, float nearPressure, float wallPressure)
{
    float3 offset = FloorMirror(neighbour) - pos;
    float d2 = dot(offset, offset);
    if (d2 <= 0 || d2 >= smoothingRadius * smoothingRadius) return 0;
    float d = sqrt(d2);
    // Extend the neighbour pressure below the floor with the hydrostatic gradient.
    float ghostPressure = wallPressure +
        neighbourDensity.x * abs(gravity) * 2 * (neighbour.y - beakerGlassFloorY);
    float sharedWallPressure = max(0, .5 * (pressure + ghostPressure));
    float sharedNear = .5 * (nearPressure + NearPressureFromDensity(neighbourDensity.y));
    return (offset / d) * (
        DensityDerivative(d, smoothingRadius) * sharedWallPressure / neighbourDensity.x +
        NearDensityDerivative(d, smoothingRadius) * sharedNear / neighbourDensity.y);
}

float3 BoxPressureForce(float4 plane, float3 pos, float3 neighbour, float2 neighbourDensity,
    float pressure, float nearPressure, float neighbourPressure)
{
    float gap = BoxPlaneDistance(plane, neighbour);
    if (gap < 0) return 0;
    float3 offset = neighbour - 2 * gap * plane.xyz - pos;
    float d2 = dot(offset, offset);
    if (d2 <= 0 || d2 >= smoothingRadius * smoothingRadius) return 0;
    float d = sqrt(d2);
    float ghostPressure = neighbourPressure + neighbourDensity.x * abs(gravity) * 2 * gap * plane.y;
    float sharedPressure = max(0, .5 * (pressure + ghostPressure));
    float sharedNear = .5 * (nearPressure + NearPressureFromDensity(neighbourDensity.y));
    return (offset / d) * (
        DensityDerivative(d, smoothingRadius) * sharedPressure / neighbourDensity.x +
        NearDensityDerivative(d, smoothingRadius) * sharedNear / neighbourDensity.y);
}

float LiquidPressure(float density, uint index)
{
#ifdef THERMAL_PRESSURE
    if (ThermalBuoyancy > .5)
    {
        float row = clamp(PressureTemperatureRise[index], 0, (float)(BuoyancyDensityCount - 1));
        int low = min((int)row, BuoyancyDensityCount - 2);
        float ratio = lerp(BuoyancyDensity[low], BuoyancyDensity[low + 1], row - low) / BuoyancyDensity[0];
        // Particle masses remain fixed during thermal expansion. Warm water
        // reaches zero pressure at a lower SPH mass density.
        return (density - targetDensity * ratio) * pressureMultiplier;
    }
#endif
    return PressureFromDensity(density);
}

[numthreads(ThreadGroupSize, 1, 1)]
#ifdef THERMAL_PRESSURE
void CalculateThermalPressureForce(uint3 id : SV_DispatchThreadID)
#elif defined(MIXED_RESOLUTION)
void CalculateMixedPressureForce(uint3 id : SV_DispatchThreadID)
#else
void CalculatePressureForce(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= numParticles)
        return;

#ifdef MIXED_RESOLUTION
    ApplyMixedPressure(id.x);
#else
    float selfWeight = LiquidWeight(id.x);
    if (selfWeight <= 0) return;

    // Calculate pressure
    float density = Densities[id.x][0];
    float densityNear = Densities[id.x][1];
    float pressure = LiquidPressure(density, id.x);
    float nearPressure = NearPressureFromDensity(densityNear);
    float3 pressureForce = 0;
    float3 velocity = Velocities[id.x];

    float3 pos = PredictedPositions[id.x];
    float3 gridPosition = pos / smoothingRadius;
    int3 originCell = (int3)floor(gridPosition);
    // Keep borderline cells despite floating-point rounding near grid boundaries.
    float3 cellPadding = 1e-6 * max(abs(gridPosition), 1);
    float sqrRadius = smoothingRadius * smoothingRadius;
    int neighbourCount = 0;
    bool floorSupport = BeakerFloorPressure > .5 && SupportsFloorMirror(pos) && pos.y - beakerGlassFloorY < smoothingRadius;
    float4 wallPlane = FindBoxPressurePlane(pos);
    bool boxSupport = any(wallPlane.xyz != 0);
    if (boxSupport)
        pressureForce += selfWeight * BoxPressureForce(wallPlane, pos, pos,
            float2(density, densityNear), pressure, nearPressure, pressure);
    if (floorSupport)
        pressureForce += selfWeight * FloorPressureForce(pos, pos, float2(density, densityNear), pressure, nearPressure, pressure);

    // Foam variables
    float weightedVelocityDifference = 0;
    float3 surfaceOffset = 0;


    // Neighbour search
    for (int i = 0; i < 27; i++)
    {
        int3 cell = originCell + offsets3D[i];
        if (!IntersectsSupportCell(gridPosition, cell, cellPadding)) continue;
        uint hash = HashCell3D(cell);
        uint key = KeyFromHash(hash, numParticles);
        uint currIndex = SpatialOffsets[key];

        while (currIndex < numParticles)
        {
            uint neighbourIndex = currIndex;
            currIndex++;

            // Skip if looking at self
            if (neighbourIndex == id.x) continue;

            uint neighbourKey = SpatialKeys[neighbourIndex];
            // Exit if no longer looking at correct bin
            if (neighbourKey != key) break;

            float3 neighbourPos = PredictedPositions[neighbourIndex];
            float3 offsetToNeighbour = neighbourPos - pos;
            float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

            // Skip if not within radius
            if (sqrDstToNeighbour > sqrRadius) continue;
            // A hash bucket can contain particles from multiple cells.
            if (any(GetCell3D(neighbourPos, smoothingRadius) != cell)) continue;

            float weight = LiquidWeight(neighbourIndex);
            if (weight <= 0) continue;

            // Calculate pressure force
            float densityNeighbour = Densities[neighbourIndex][0];
            float nearDensityNeighbour = Densities[neighbourIndex][1];
            float neighbourPressure = LiquidPressure(densityNeighbour, neighbourIndex);
            float neighbourPressureNear = NearPressureFromDensity(nearDensityNeighbour);

            float sharedPressure = (pressure + neighbourPressure) / 2;
            float sharedNearPressure = (nearPressure + neighbourPressureNear) / 2;

            float dstToNeighbour = sqrt(sqrDstToNeighbour);
            float3 dirToNeighbour = dstToNeighbour > 0 ? offsetToNeighbour / dstToNeighbour : float3(0, 1, 0);
            neighbourCount++;

            // Update pressure force
            pressureForce += weight * dirToNeighbour * DensityDerivative(dstToNeighbour, smoothingRadius) * sharedPressure / densityNeighbour;
            pressureForce += weight * dirToNeighbour * NearDensityDerivative(dstToNeighbour, smoothingRadius) * sharedNearPressure / nearDensityNeighbour;
            if (boxSupport)
                pressureForce += weight * BoxPressureForce(wallPlane, pos, neighbourPos,
                    float2(densityNeighbour, nearDensityNeighbour), pressure, nearPressure, neighbourPressure);
            if (floorSupport && SupportsFloorMirror(neighbourPos))
                pressureForce += weight * FloorPressureForce(pos, neighbourPos,
                    float2(densityNeighbour, nearDensityNeighbour), pressure, nearPressure, neighbourPressure);

            [branch]
            if (diffuseActive)
            {
                // ---- White Particle 'Trapped Air' Calculation ----
                float3 relativeVelocity = velocity - Velocities[neighbourIndex];
                float relativeVelocityMagnitude = length(relativeVelocity);
                float3 relativeVelocityDir = relativeVelocity / max(0.000001, relativeVelocityMagnitude);
                // 0 if moving in opposite directions; up to 2 if moving directly toward one another
                float convergeWeight = 1 - dot(relativeVelocityDir, -dirToNeighbour);
                // 1 when distance between particles is 0, down to 0 when distance reaches the smoothing radius
                float influence = 1 - min(1, dstToNeighbour / smoothingRadius);
                // Sum up weighted velocity diff between current particle and each of its surrounding neighbours
                weightedVelocityDifference += relativeVelocityMagnitude * convergeWeight * influence;
                if (sprayOnly) surfaceOffset -= dirToNeighbour * influence;
            }
        }
    }

    float3 acceleration = pressureForce / density;
    float3 velocityNew = velocity + acceleration * deltaTime;
    Velocities[id.x] = velocityNew;

    // Quick test -- apply some drag to airborne fluid particles
    if (neighbourCount < 8)
    {
        Velocities[id.x] -= Velocities[id.x] * deltaTime * 0.75;
    }


    // ---- Handle spawning of white particles from the current fluid particle ----
    if (!diffuseActive) return;
    uint rngState = dot(asuint(float4(pos, simTime)), uint4(19349669, 83492837, 73856131, 4785773));
    if (id.x == 0) WhiteParticleCounters[1] = 0; // Reset survivor counter

    float trappedAirFactor = trappedAirParams[0] * Remap01(weightedVelocityDifference, trappedAirParams[1], trappedAirParams[2]);
    float kineticEnergyFactor = Remap01(dot(velocity, velocity), kineticEnergyParams[0], kineticEnergyParams[1]);
    float crestFactor = 0;
    float3 outward = 0;
    if (sprayOnly)
    {
        if (neighbourCount > 28) return;
        outward = surfaceOffset / max(length(surfaceOffset), 1e-6);
        float crest = Remap01(dot(velocityNew, outward), .12, .9);
        crestFactor = trappedAirParams[0] * crest;
    }
    float particleSpawnFactor = (trappedAirFactor + crestFactor) * kineticEnergyFactor * deltaTime;

    // Determine number of white particles to spawn. For example if the spawn factor is 3.7
    // then we will spawn at least 3 particles, with a 70% chance of spawning a 4th particle
    int particleSpawnCount = floor(particleSpawnFactor);
    float fractionalSpawnRemainder = particleSpawnFactor - particleSpawnCount;
    if (RandomValue(rngState) < fractionalSpawnRemainder) particleSpawnCount += 1;

    //uint targ = NextRandom(rngState) % 4096;

    //InterlockedAdd(WhiteParticleCounters[targ], 1);

    if (particleSpawnCount > 0)
    {
        uint particleIndex;
        InterlockedAdd(WhiteParticleCounters[0], (uint)particleSpawnCount, particleIndex);
        if (particleIndex >= MaxWhiteParticleCount) return;
        particleSpawnCount = (int)min((uint)particleSpawnCount, MaxWhiteParticleCount - particleIndex);

        float3 cylinderBase = pos + outward * (.65 * smoothingRadius);
        float3 cylinderTop = cylinderBase + velocityNew * deltaTime; // height of cylinder determined by fluid velocity
        float3 launchAxis = length(velocityNew) > 1e-6 ? normalize(velocityNew) : float3(0,1,0);
        float3 cylinderAxisA = CalculateOrthonormal(launchAxis); // arbitrary direction along base of cylinder
        float3 cylinderAxisB = normalize(cross(cylinderAxisA, launchAxis));
        float cylinderRadius = smoothingRadius * (sprayOnly ? .45 : 1);
        float clusterMin, clusterMax;
        for (int spawnIndex = 0; spawnIndex < particleSpawnCount; spawnIndex++)
        {
            float randomAngle = RandomValue(rngState) * 2 * 3.1415;
            float3 offsetDir = cos(randomAngle) * cylinderAxisA + sin(randomAngle) * cylinderAxisB;
            float3 baseOffset = sqrt(RandomValue(rngState)) * cylinderRadius * offsetDir; // random point on cylinder base
            float3 spawnPos = cylinderBase + baseOffset + (cylinderTop - cylinderBase) * RandomValue(rngState);

            float dissolveTimeMin = 5;
            float dissolveTimeMax = 15;
            float lifetime = sprayOnly ? 1.0 :
                lerp(dissolveTimeMin, dissolveTimeMax, RandomValue(rngState));

            // Spawn new particle
            WhiteParticle whiteParticle;
            whiteParticle.position = spawnPos;
            whiteParticle.velocity = sprayOnly ? velocityNew + .25 * outward : velocityNew + baseOffset;
            whiteParticle.remainingLifetime = lifetime;
            whiteParticle.scale = (bubbleScale + 1) / 2;
            WhiteParticles[particleIndex + spawnIndex] = whiteParticle;
        }
    }
#endif
}

[numthreads(ThreadGroupSize, 1, 1)]
#ifdef MIXED_RESOLUTION
void CalculateMixedViscosity(uint3 id : SV_DispatchThreadID)
#else
void CalculateViscosity(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= numParticles)
        return;

#ifdef MIXED_RESOLUTION
    ApplyMixedViscosity(id.x);
#else
    float3 pos = PredictedPositions[id.x];
    float3 gridPosition = pos / smoothingRadius;
    int3 originCell = (int3)floor(gridPosition);
    // Keep borderline cells despite floating-point rounding near grid boundaries.
    float3 cellPadding = 1e-6 * max(abs(gridPosition), 1);
    float sqrRadius = smoothingRadius * smoothingRadius;

    float3 viscosityForce = 0;
    float3 contactCorrection = 0;
    float3 velocity = Velocities[id.x];

    // Neighbour search
    for (int i = 0; i < 27; i++)
    {
        int3 cell = originCell + offsets3D[i];
        if (!IntersectsSupportCell(gridPosition, cell, cellPadding)) continue;
        uint hash = HashCell3D(cell);
        uint key = KeyFromHash(hash, numParticles);
        uint currIndex = SpatialOffsets[key];

        while (currIndex < numParticles)
        {
            uint neighbourIndex = currIndex;
            currIndex++;

            uint neighbourKey = SpatialKeys[neighbourIndex];
            // Exit if no longer looking at correct bin
            if (neighbourKey != key)
                break;


            // Skip if looking at self
            if (neighbourIndex == id.x)
                continue;

            float3 neighbourPos = PredictedPositions[neighbourIndex];
            float3 offsetToNeighbour = neighbourPos - pos;
            float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

            // Skip if not within radius
            if (sqrDstToNeighbour > sqrRadius)
                continue;
            // A hash bucket can contain particles from multiple cells.
            if (any(GetCell3D(neighbourPos, smoothingRadius) != cell)) continue;

            // Calculate viscosity
            float dst = sqrt(sqrDstToNeighbour);
            float3 neighbourVelocity = Velocities[neighbourIndex];
            float3 relative = neighbourVelocity - velocity;
            float weight = LiquidWeight(neighbourIndex);
            if (approachOnlyDamping)
            {
                if (dst <= 1e-8 || dst >= particleDampingDistance) continue;
                float3 axis = offsetToNeighbour / dst;
                float closingSpeed = max(0.0, -dot(relative, axis));
                if (dst <= particleContactDistance)
                {
                    // Equal particles share the impulse that cancels inward normal motion.
                    contactCorrection -= .5 * weight * closingSpeed * axis;
                }
                else
                {
                    float taper = 1 - saturate((dst - particleContactDistance) /
                        (particleDampingDistance - particleContactDistance));
                    float rate = SmoothingKernelPoly6(0, smoothingRadius) * viscosityStrength;
                    float impulse = min(.5, rate * deltaTime * taper) * closingSpeed;
                    contactCorrection -= weight * impulse * axis;
                }
                continue;
            }
            viscosityForce += weight * relative * SmoothingKernelPoly6(dst, smoothingRadius);
        }
    }
    float3 damped = velocity + viscosityForce * viscosityStrength * deltaTime;
    if (approachOnlyDamping) SortTarget_Velocities[id.x] = velocity + contactCorrection;
    else Velocities[id.x] = damped;
#endif
}

[numthreads(ThreadGroupSize, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;

    float3 vel = Velocities[id.x];
    float3 previous = Positions[id.x];
    float3 pos = previous + vel * deltaTime;

    ResolveIce(previous, pos, vel);
    ResolveCollisions(pos, vel, collisionDamping);
    ResolveBeaker(previous, pos, vel);

    // Write results
    Positions[id.x] = pos;
    Velocities[id.x] = vel;
}

[numthreads(8, 8, 8)]
#ifdef MIXED_RESOLUTION
void UpdateMixedDensityTexture(uint3 id : SV_DispatchThreadID)
#else
void UpdateDensityTexture(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= densityMapSize.x || id.y >= densityMapSize.y || id.z >= densityMapSize.z)
        return;

    // Convert threadID to a world-space position, and sample the fluid density at that point
    float3 texturePos = id / (densityMapSize - 1.0);
    float3 worldPos = (texturePos - 0.5) * boundsSize + densityMapCentre;
    for (int index = 0; index < iceCount; index++)
    {
        if (all(abs(mul(iceWorldToLocal[index], float4(worldPos, 1)).xyz) < iceHalfExtents[index].xyz))
        {
            DensityMap[id] = 0;
            return;
        }
    }
#ifdef MIXED_RESOLUTION
    DensityMap[id] = MixedDensityAt(worldPos, 0, true).x;
#else
    DensityMap[id] = CalculateDensitiesAtPoint(worldPos, false)[0];
#endif
}

[numthreads(ThreadGroupSize, 1, 1)]
void UpdateWhiteParticles(uint3 id : SV_DispatchThreadID)
{
    // Early exit if thread index exceeds particle count
    if (id.x >= min(MaxWhiteParticleCount, WhiteParticleCounters[0])) return;

    // Update particle
    float deltaTime = whiteParticleDeltaTime;
    WhiteParticle particle = WhiteParticles[id.x];

    // -- Neighbour fluid partices ---
    int3 originCell = GetCell3D(particle.position, smoothingRadius);
    float sqrRadius = smoothingRadius * smoothingRadius;
    int neighbourCount = 0;
    float3 velocitySum = 0;
    float weightSum = 0;

    for (int i = 0; i < 27; i++)
    {
        uint hash = HashCell3D(originCell + offsets3D[i]);
        uint key = KeyFromHash(hash, numParticles);
        uint currIndex = SpatialOffsets[key];

        while (currIndex < numParticles)
        {
            uint neighbourIndex = currIndex;
            currIndex++;

            uint neighbourKey = SpatialKeys[neighbourIndex];
            // Exit if no longer looking at correct bin
            if (neighbourKey != key)
                break;

            float3 neighbourPos = PredictedPositions[neighbourIndex];
            float3 offsetToNeighbour = neighbourPos - particle.position;
            float sqrDstToNeighbour = dot(offsetToNeighbour, offsetToNeighbour);

            if (sqrDstToNeighbour < sqrRadius)
            {
                float dstToNeighbour = sqrt(sqrDstToNeighbour);
                float influenceWeight = SmoothingKernelPoly6(dstToNeighbour, smoothingRadius);

                // Add up velocities of nearby fluid particles, weighted smoothly by distance.
                // Also add up the weights so that we can compute the average fluid velocity.
                velocitySum += Velocities[neighbourIndex] * influenceWeight;
                weightSum += influenceWeight;

                neighbourCount += 1;
            }
        }
    }

    // -- Classify --
    bool isSpray = neighbourCount <= sprayClassifyMaxNeighbours;
    if (sprayOnly)
    {
        // Let new droplets clear the source wave before testing re-entry.
        if (!isSpray && particle.remainingLifetime <= .92) return;
        isSpray = true;
        particle.remainingLifetime -= deltaTime;
    }
    bool isBubble = !sprayOnly && neighbourCount >= bubbleClassifyMinNeighbours;
    bool isFoam = !(isSpray || isBubble);

    // Foam is transported by the fluid
    if (isFoam)
    {
        // We want the foam to be carried by the fluid (not just accelerated by it),
        // so the velocity is directly set to the average velocity of surrounding fluid.
        particle.velocity = velocitySum / weightSum;
        // Dissolve the foam over time
        particle.remainingLifetime -= deltaTime;
    }
    // Bubbles are accelerated by the surrounding fluid, and moved upwards due to buoyancy
    else if (isBubble)
    {
        const float fluidAccelMul = 3; // How fast the bubble accelerates to match velocity with fluid
        float3 accelerationBuoyancy = float3(0, gravity, 0) * (1 - bubbleBuoyancy);
        float3 accelerationFluid = (velocitySum / weightSum - particle.velocity) * fluidAccelMul;
        particle.velocity += (accelerationBuoyancy + accelerationFluid) * deltaTime;
    }
    // Spray is affected by gravity and drag
    else if (isSpray)
    {
        const float dragMultiplier = 0.04;
        float sqrSpeed = dot(particle.velocity, particle.velocity);
        float3 drag = -particle.velocity * sqrt(sqrSpeed) * dragMultiplier;
        particle.velocity += (float3(0, gravity, 0) + drag) * deltaTime;
    }

    float targetScale = isBubble ? bubbleScale : 1;
    particle.scale = lerp(particle.scale, targetScale, deltaTime * bubbleScaleChangeSpeed);
    float3 previous = particle.position;
    particle.position += particle.velocity * deltaTime;
    if (sprayOnly) ResolveIce(previous, particle.position, particle.velocity);

    const float collisionDampening = 0.1;
    ResolveCollisions(particle.position, particle.velocity, collisionDampening);
    WhiteParticles[id.x] = particle;

    // Compact the surviving particles into temporary buffer
    if (particle.remainingLifetime > 0)
    {
        uint survivorIndex;
        InterlockedAdd(WhiteParticleCounters[1], 1, survivorIndex);
        WhiteParticlesCompacted[survivorIndex] = particle;
    }
}


[numthreads(ThreadGroupSize, 1, 1)]
void WhiteParticlePrepareNextFrame(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= MaxWhiteParticleCount) return;

    // Copy the surviving particles back into the main particle buffer
    if (id.x < WhiteParticleCounters[1])
    {
        WhiteParticles[id.x] = WhiteParticlesCompacted[id.x];
    }

    // Set active particle count to the survivor count
    if (id.x == 0)
    {
        WhiteParticleCounters[0] = WhiteParticleCounters[1];
    }
}

StructuredBuffer<float3> WaterCopyPositions;
StructuredBuffer<float3> WaterCopyVelocities;
uint waterCopyCount;

[numthreads(ThreadGroupSize, 1, 1)]
void CopyWaterState(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= waterCopyCount) return;
    Positions[id.x] = WaterCopyPositions[id.x];
    Velocities[id.x] = WaterCopyVelocities[id.x];
}

[numthreads(ThreadGroupSize, 1, 1)]
void CommitDampedVelocities(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    Velocities[id.x] = SortTarget_Velocities[id.x];
}
