#pragma kernel ClipCutFaces

StructuredBuffer<float4> TetraVertices; // four records per tetra; first w holds sign
StructuredBuffer<int4> Jobs;           // first tetra, tetra count, axis, direction
StructuredBuffer<float4> Normals;      // unit-cell plane coefficients, liquid volume
StructuredBuffer<float2> Volumes;      // accessible cell volume, swept volume
RWStructuredBuffer<float4> Results;
int JobCount;

struct Tet { float3 a, b, c, d; };

Tet MakeTet(float3 a, float3 b, float3 c, float3 d)
{
    Tet t;
    t.a = a; t.b = b; t.c = c; t.d = d;
    return t;
}

float Volume(Tet t) { return abs(dot(t.b-t.a, cross(t.c-t.a,t.d-t.a))) / 6; }
float3 Intersection(float4 a, float4 b) { return lerp(a.xyz,b.xyz,a.w/(a.w-b.w)); }

int Clip(Tet t, float3 normal, float offset, out Tet first, out Tet second, out Tet third)
{
    float4 inside[4], outside[4];
    float3 vertices[4] = {t.a,t.b,t.c,t.d};
    int count = 0, other = 0;
    first = t; second = t; third = t;
    [unroll] for (int i = 0; i < 4; i++)
    {
        float4 vertex = float4(vertices[i],dot(normal,vertices[i])-offset);
        if (vertex.w <= 0) inside[count++] = vertex;
        else outside[other++] = vertex;
    }
    if (count == 0) return 0;
    if (count == 4) return 1;
    float4 a = inside[0], c = outside[0];
    float3 p = Intersection(a,c);
    if (count == 1)
    {
        first = MakeTet(a.xyz,p,Intersection(a,outside[1]),Intersection(a,outside[2]));
        return 1;
    }
    float4 b = inside[1];
    if (count == 2)
    {
        float4 d = outside[1];
        float3 q = Intersection(a,d), r = Intersection(b,c), s = Intersection(b,d);
        first = MakeTet(a.xyz,b.xyz,p,q);
        second = MakeTet(b.xyz,p,q,s);
        third = MakeTet(b.xyz,p,r,s);
    }
    else
    {
        float4 d = inside[2];
        float3 q = Intersection(b,c), r = Intersection(d,c);
        first = MakeTet(a.xyz,b.xyz,d.xyz,p);
        second = MakeTet(b.xyz,d.xyz,p,q);
        third = MakeTet(d.xyz,p,q,r);
    }
    return 3;
}

float HalfVolume(Tet t, float3 n, float intercept)
{
    Tet a,b,c;
    int count = Clip(t,n,intercept,a,b,c);
    if (count == 0) return 0;
    return Volume(a) + (count == 3 ? Volume(b) + Volume(c) : 0);
}

float3 AxisVector(int axis)
{
    return axis == 0 ? float3(1,0,0) : axis == 1 ? float3(0,1,0) : float3(0,0,1);
}

float3 ReflectAtUpperFace(float3 p, float3 axis)
{
    return p * (1-axis) + (1-p) * axis;
}

float Integrate(int4 job, float3 n, float intercept, float3 slab, float edge, bool twoPlanes)
{
    precise float sum = 0, correction = 0;
    for (int j = 0; j < job.y; j++)
    {
        int index = (job.x+j)*4;
        float4 first = TetraVertices[index];
        Tet t = MakeTet(first.xyz,TetraVertices[index+1].xyz,TetraVertices[index+2].xyz,TetraVertices[index+3].xyz);
        if (job.w < 0)
        {
            float3 axis = AxisVector(job.z);
            t = MakeTet(ReflectAtUpperFace(t.a,axis),ReflectAtUpperFace(t.b,axis),
                ReflectAtUpperFace(t.c,axis),ReflectAtUpperFace(t.d,axis));
        }
        float amount;
        if (twoPlanes)
        {
            Tet a,b,c;
            int count = Clip(t,slab,edge,a,b,c);
            amount = count > 0 ? HalfVolume(a,n,intercept) : 0;
            if (count == 3) amount += HalfVolume(b,n,intercept) + HalfVolume(c,n,intercept);
        }
        else amount = HalfVolume(t,n,intercept);
        precise float term = first.w*amount-correction;
        precise float next = sum+term;
        correction = (next-sum)-term;
        sum = next;
    }
    return sum;
}

[numthreads(64, 1, 1)]
void ClipCutFaces(uint3 id : SV_DispatchThreadID)
{
    int f = (int)id.x;
    if (f >= JobCount) return;
    int4 job = Jobs[f];
    float4 plane = Normals[f];
    float2 volume = Volumes[f];
    float3 slab = AxisVector(job.z);
    // For outward flow at the positive face, reflect the cell so the
    // slab is always measured from zero. Tiny widths retain precision.
    float3 n = job.w < 0 ? plane.xyz * (1-2*slab) : plane.xyz;
    float lo = dot(min(n,0),float3(1,1,1)), hi = dot(max(n,0),float3(1,1,1));
    for (int i = 0; i < 25; i++)
    {
        float middle = .5*(lo+hi);
        if (Integrate(job,n,middle,0,0,false) < plane.w) lo = middle;
        else hi = middle;
    }
    float intercept = .5*(lo+hi);
    lo = 0; hi = 1;
    for (int i = 0; i < 36; i++)
    {
        float middle = .5*(lo+hi);
        if (Integrate(job,slab,middle,0,0,false) < volume.y) lo = middle;
        else hi = middle;
    }
    float edge = .5*(lo+hi);
    Results[f] = float4(Integrate(job,n,intercept,slab,edge,true),
        Integrate(job,n,intercept,0,0,false)-plane.w,
        Integrate(job,slab,edge,0,0,false)-volume.y,
        Integrate(job,slab,1,0,0,false)-volume.x);
}
