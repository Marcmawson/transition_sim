#pragma kernel Conduct
StructuredBuffer<float> TemperatureRead;
RWStructuredBuffer<float> TemperatureWrite;
StructuredBuffer<float> Capacity;
StructuredBuffer<float> BurnerPower;
StructuredBuffer<float> ExposedArea;
RWStructuredBuffer<float> RoomEnergyJ;
RWStructuredBuffer<float> BurnerEnergyJ;
RWStructuredBuffer<float> BurnerEntropyJPerK;
StructuredBuffer<int> FaceStart;
struct FaceLink { int Other; float Conductance; };
StructuredBuffer<FaceLink> FaceLinks;
int CellCount;
float StepSeconds;
float AbsorbedPowerW;
float RoomFilmWm2K;
float RoomTemperatureK;

[numthreads(64, 1, 1)]
void Conduct(uint3 id : SV_DispatchThreadID)
{
    uint cell = id.x;
    if (cell >= (uint)CellCount) return;
    float temperature = TemperatureRead[cell];
    float burnerPower = AbsorbedPowerW * BurnerPower[cell];
    float burnerHeat = StepSeconds * burnerPower;
    BurnerEnergyJ[cell] += burnerHeat;
    BurnerEntropyJPerK[cell] += burnerHeat / (RoomTemperatureK + temperature);
    float power = burnerPower;
    for (int i = FaceStart[cell]; i < FaceStart[cell + 1]; i++)
    {
        FaceLink link = FaceLinks[i];
        power += link.Conductance * (TemperatureRead[link.Other] - temperature);
    }
    // Temperature is stored relative to the 20 C room.
    float roomPower = RoomFilmWm2K * ExposedArea[cell] * temperature;
    RoomEnergyJ[cell] += StepSeconds * roomPower;
    TemperatureWrite[cell] = temperature + StepSeconds * (power - roomPower) / Capacity[cell];
}
