#pragma kernel PredictMomentum
#pragma kernel IteratePressure
#pragma kernel CorrectVelocity
#include "VofCompensated.hlsl"

struct Face
{
    int low, high, axis, active;
    float area, mobility, boundaryPressure, viscosity;
};

StructuredBuffer<Face> Faces;
StructuredBuffer<int> Stencil;
StructuredBuffer<float> ViscousRates;
StructuredBuffer<int> Rows;
StructuredBuffer<int> Incidence;
StructuredBuffer<float4> PressureRows; // diagonal, high and low words of tentative outward volume flux / Dt
StructuredBuffer<float> VelocityIn;
StructuredBuffer<float> PredictedIn;
StructuredBuffer<float2> PressureIn;
RWStructuredBuffer<float> PredictedOut;
RWStructuredBuffer<float2> PressureOut;
RWStructuredBuffer<float> CorrectedOut;

int FaceCount, GroupCount;
float Dt;
float4 InverseSpacing, Acceleration;

float SampleVelocity(int index, float centre)
{
    if (index >= 0) return VelocityIn[index];
    if (index == -2) return -centre;
    if (index == -3) return centre;
    return 0;
}

float2 PressureGradient(Face face)
{
    float2 low = V(face.boundaryPressure);
    float2 high = low;
    if (face.low >= 0) low = PressureIn[face.low];
    if (face.high >= 0) high = PressureIn[face.high];
    return Mul(Sub(high, low), V(face.mobility));
}

[numthreads(64, 1, 1)]
void PredictMomentum(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)FaceCount) return;
    Face face = Faces[index];
    if (face.active == 0)
    {
        PredictedOut[index] = 0;
        return;
    }

    float centre = VelocityIn[index];
    int row = (int)index * 9;
    float change = Acceleration[face.axis] - ViscousRates[row + 6] * centre;
    int start = (int)index * 18;
    for (int axis = 0; axis < 3; axis++)
    {
        float lower = SampleVelocity(Stencil[start + 2 * axis], centre);
        float upper = SampleVelocity(Stencil[start + 2 * axis + 1], centre);
        float transport = 0;
        for (int sample = 0; sample < 4; sample++)
            transport += SampleVelocity(Stencil[start + 6 + 4 * axis + sample], centre) * 0.25;
        if (axis != face.axis)
            change -= ViscousRates[row + 7 + (axis + 3 - face.axis) % 3 - 1] * transport;
        float derivative = transport >= 0 ? centre - lower : upper - centre;
        float inverse = InverseSpacing[axis];
        change += ViscousRates[row + 2 * axis] * (lower - centre)
            + ViscousRates[row + 2 * axis + 1] * (upper - centre)
            - transport * derivative * inverse;
    }
    PredictedOut[index] = centre + Dt * change;
}

[numthreads(64, 1, 1)]
void IteratePressure(uint3 id : SV_DispatchThreadID)
{
    uint group = id.x;
    if (group >= (uint)GroupCount) return;
    // The tentative flux is reduced once in FP64 from the existing predictor
    // readback, so near-cancelling face velocities retain their small net flux.
    float2 pressureFlux = V(0);
    for (int entry = Rows[group]; entry < Rows[group + 1]; entry++)
    {
        int incidence = Incidence[entry];
        int index = abs(incidence) - 1;
        Face face = Faces[index];
        float area = incidence > 0 ? face.area : -face.area;
        pressureFlux = Add(pressureFlux, Mul(V(area), PressureGradient(face)));
    }
    float4 row = PressureRows[group];
    float2 residual = Sub(pressureFlux, row.yz);
    // The increment may be much smaller than the leading pressure word.
    float update = row.x > 0 ? (2.0 / 3.0) * (residual.x + residual.y) / row.x : 0;
    PressureOut[group] = row.x > 0 ? Add(PressureIn[group], V(update)) : V(0);
}

[numthreads(64, 1, 1)]
void CorrectVelocity(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)FaceCount) return;
    Face face = Faces[index];
    if (face.active == 0)
    {
        CorrectedOut[index] = 0;
        return;
    }
    float2 result = Sub(V(PredictedIn[index]), Mul(V(Dt), PressureGradient(face)));
    CorrectedOut[index] = result.x + result.y;
}
