#pragma kernel ClearContacts
#pragma kernel FindContacts
#pragma kernel ExchangeHeat
#pragma kernel ExchangeHeatAndBoil BOILING
#pragma kernel ReduceRingHeat
#pragma kernel ConductGlass
#pragma kernel MeasureVerticalFlow

StructuredBuffer<float3> Positions;
StructuredBuffer<float3> Velocities;
RWStructuredBuffer<float4> FlowTotals;
float BeakerRim;
RWStructuredBuffer<float> TemperatureRise;
StructuredBuffer<float> GlassRead;
RWStructuredBuffer<float> GlassWrite;
StructuredBuffer<float> GlassCapacity;
StructuredBuffer<float> BurnerWeight;
RWStructuredBuffer<float> BurnerEntropyJPerK;
float InitialTemperatureK;
StructuredBuffer<int> FaceStart;
struct Link { int Other; float Conductance; };
StructuredBuffer<Link> FaceLinks;
RWStructuredBuffer<uint> ContactCounts;
RWStructuredBuffer<int> ContactRing;
RWStructuredBuffer<float> ParticleGain;
RWStructuredBuffer<float> RingGain;
uint ParticleCount, RingCount, BaseDepth, SolidCount;
float RingWidth, ContactRadius, ContactFloor, ContactDepth;
float ParticleArea, ParticleCapacity, ConductancePerArea, Dt, BurnerWatts;
groupshared float partial[64];
groupshared float4 partialFlow[64];
groupshared float4 partialCounts[64];
groupshared float partialFloorContacts[64];

[numthreads(64,1,1)]
void ClearContacts(uint3 id : SV_DispatchThreadID)
{
    if (id.x < RingCount) ContactCounts[id.x] = 0;
}

[numthreads(64,1,1)]
void FindContacts(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount) return;
    float3 p = Positions[id.x];
    float radius = length(p.xz);
    int ring = -1;
    if (radius < ContactRadius && p.y >= ContactFloor - 1e-5 && p.y <= ContactFloor + ContactDepth)
    {
        ring = min((int)(radius / RingWidth), (int)RingCount - 1);
        InterlockedAdd(ContactCounts[ring], 1);
    }
    ContactRing[id.x] = ring;
}

#ifdef BOILING
RWStructuredBuffer<float> VapourProduction;
RWStructuredBuffer<float> LiquidFraction;
float SaturationRiseK, ParticleMassKg, LatentHeatJkg;
#endif

[numthreads(64,1,1)]
#ifdef BOILING
void ExchangeHeatAndBoil(uint3 id : SV_DispatchThreadID)
#else
void ExchangeHeat(uint3 id : SV_DispatchThreadID)
#endif
{
    if (id.x >= ParticleCount) return;
    int ring = ContactRing[id.x];
    float gain = 0;
    if (ring >= 0)
    {
        float area = 3.14159265 * (2 * ring + 1) * RingWidth * RingWidth;
        float wetted = min(ParticleArea, area / ContactCounts[ring]);
        uint glass = (ring + 1) * BaseDepth - 1;
        float liquidFraction = 1;
#ifdef BOILING
        liquidFraction = LiquidFraction[id.x];
        if (liquidFraction <= 0) { ParticleGain[id.x] = 0; return; }
#endif
        float capacity = ParticleCapacity * liquidFraction;
        gain = Dt * ConductancePerArea * wetted * liquidFraction * (GlassRead[glass] - TemperatureRise[id.x]);
        float rise = TemperatureRise[id.x] + gain / capacity;
#ifdef BOILING
        // Only heat above saturation supplies the latent energy of new vapour.
        float excess = max(0, rise - SaturationRiseK) * capacity;
        float remaining = liquidFraction - min(liquidFraction, excess / (ParticleMassKg * LatentHeatJkg));
        float evaporatedFraction = liquidFraction - remaining;
        LiquidFraction[id.x] = remaining;
        VapourProduction[id.x] += evaporatedFraction * ParticleMassKg;
        float sensibleRemainder = capacity * (rise - SaturationRiseK) -
            evaporatedFraction * ParticleMassKg * LatentHeatJkg;
        if (remaining > 0 && evaporatedFraction > 0)
            rise = SaturationRiseK + sensibleRemainder / (ParticleCapacity * remaining);
        else if (remaining <= 0)
            rise = SaturationRiseK;
#endif
        TemperatureRise[id.x] = rise;
    }
    ParticleGain[id.x] = gain;
}

[numthreads(64,1,1)]
void ReduceRingHeat(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    float sum = 0;
    for (uint i = lane; i < ParticleCount; i += 64)
        if (ContactRing[i] == (int)group.x) sum += ParticleGain[i];
    partial[lane] = sum;
    GroupMemoryBarrierWithGroupSync();
    for (uint stride = 32; stride > 0; stride >>= 1)
    {
        if (lane < stride) partial[lane] += partial[lane + stride];
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0) RingGain[group.x] = partial[0];
}

StructuredBuffer<float> RoomConductance;
RWStructuredBuffer<float> RoomHeatJ;

[numthreads(64,1,1)]
void ConductGlass(uint3 id : SV_DispatchThreadID)
{
    uint cell = id.x;
    if (cell >= SolidCount) return;
    float rise = GlassRead[cell];
    float power = BurnerWatts * BurnerWeight[cell];
    BurnerEntropyJPerK[cell] += Dt * power / (InitialTemperatureK + rise);
    for (int i = FaceStart[cell]; i < FaceStart[cell+1]; i++)
    {
        Link link = FaceLinks[i];
        power += link.Conductance * (GlassRead[link.Other] - rise);
    }
    float roomPower = RoomConductance[cell] * rise;
    RoomHeatJ[cell] += Dt * roomPower;
    power -= roomPower;
    uint ring = cell / BaseDepth;
    float loss = cell % BaseDepth == BaseDepth - 1 && ring < RingCount ? RingGain[ring] : 0;
    GlassWrite[cell] = rise + (Dt * power - loss) / GlassCapacity[cell];
}

[numthreads(64,1,1)]
void MeasureVerticalFlow(uint3 group : SV_GroupID, uint lane : SV_GroupIndex, uint3 id : SV_DispatchThreadID)
{
    float4 flow = 0;
    float4 counts = 0;
    float floorContacts = 0;
    if (id.x < ParticleCount)
    {
        float3 p = Positions[id.x];
        float speedY = Velocities[id.x].y;
        float rise = TemperatureRise[id.x];
        if (p.y >= ContactFloor - 1e-5 && p.y < BeakerRim &&
            dot(p.xz, p.xz) <= ContactRadius * ContactRadius + 1e-8 &&
            !isnan(speedY) && !isinf(speedY) && !isnan(rise) && !isinf(rise))
        {
            counts.w = max(0, rise);
            floorContacts = p.y <= ContactFloor + ContactDepth ? 1 : 0;
            if (rise >= 1)
            {
                float height = max(0, p.y - ContactFloor);
                flow = float4(1, height, speedY, 0);
                if (height > .0005) counts.yz = float2(1, speedY);
            }
            else { flow.w = speedY; counts.x = 1; }
        }
    }

    partialFlow[lane] = flow;
    partialCounts[lane] = counts;
    partialFloorContacts[lane] = floorContacts;
    GroupMemoryBarrierWithGroupSync();
    for (uint stride = 32; stride > 0; stride >>= 1)
    {
        if (lane < stride)
        {
            partialFlow[lane] += partialFlow[lane + stride];
            partialFloorContacts[lane] += partialFloorContacts[lane + stride];
            partialCounts[lane].xyz += partialCounts[lane + stride].xyz;
            partialCounts[lane].w = max(partialCounts[lane].w, partialCounts[lane + stride].w);
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0)
    {
        FlowTotals[3 * group.x] = partialFlow[0];
        FlowTotals[3 * group.x + 1] = partialCounts[0];
        FlowTotals[3 * group.x + 2] = float4(partialFloorContacts[0], 0, 0, 0);
    }
}
